class Solution {
    public int uniquePathsWithObstacles(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;
        if(grid[n-1][m-1] == 1 || grid[0][0] == 1) return 0;
  int dp[][] = new int[n+1][m+1];
        for(int i =0; i< n ; i++){
            Arrays.fill(dp[i],-1);
        }
        int count =0;
    return  help(grid,0,0,dp);
    }

    public int help(int grid[][],int st,int en,int dp[][]){
       if(st > grid.length-1 || en > grid[0].length-1) return 0;
         if(st == grid.length-1 && en == grid[0].length-1){
            return 1;
        }
         
          if(dp[st][en] != -1) return dp[st][en];
     
          if(grid[st][en] == 1) return 0;
      
       
       

        int left = help(grid,st ,en +1,dp);
        int right = help(grid,st+1,en,dp);

        return dp[st][en]= left + right;
    }
}
