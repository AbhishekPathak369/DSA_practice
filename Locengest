class Solution {
    public int longestCommonSubsequence(String S1, String S2) {
        
        int n1 = S1.length();
        int n2 = S2.length();
      int dp[][] = new int[n1][n2];
      for(int i =0; i< n1; i++){
        Arrays.fill(dp[i],-1);
      }

    return help(S1,S2,n1-1,n2-1,dp);  

    }
    public int help(String S1, String S2,int n1, int n2,int dp[][]){
        if(n1 < 0 || n2 <0) return 0;
        if(dp[n1][n2] != -1) return dp[n1][n2];
        int match =0;
    if(S1.charAt(n1) == S2.charAt(n2)){
          match =1 + help(S1, S2,n1-1,n2-1,dp); 
       
    }
        else {
            match = Math.max(help(S1, S2,n1,n2-1,dp),help(S1, S2,n1-1,n2,dp));
        }
return dp[n1][n2] = match;
    }
}
